{%- comment -%}
  Pre-launch announcement + founding-member signup. Uses Shopify's native
  customer form (same mechanism as the theme's own email-signup block) so
  submissions land as real Shopify customers with marketing consent, no
  third-party form service required. Extends it with an optional phone field
  and a hidden `contact[tags]` value so the merchant can segment founding
  members in Admin once real launch prep begins.
{%- endcomment -%}

<div
  id="irth-gold-membership"
  class="irth-gold"
  style="scroll-margin-top: var(--header-height, 0px);"
>
  <div class="irth-gold__inner">
    <div class="irth-gold__panel">
      <p class="irth-gold__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2 class="irth-gold__heading">{{ section.settings.heading | escape }}</h2>
      <div class="irth-gold__body">{{ section.settings.body }}</div>

      {%- form 'customer', class: 'irth-gold__form' -%}
        <input type="hidden" name="contact[tags]" value="{{ section.settings.signup_tags | escape }}">

        <div class="irth-gold__fields">
          <div class="irth-gold__field">
            <label for="IrthGoldEmail-{{ section.id }}" class="visually-hidden">
              {{ 'blocks.email_signup.label' | t }}
            </label>
            <input
              id="IrthGoldEmail-{{ section.id }}"
              class="irth-gold__input"
              type="email"
              name="contact[email]"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              placeholder="{{ section.settings.email_placeholder | escape }}"
              required
              {% if form.errors and form.id == blank %}
                autofocus
                aria-invalid="true"
                aria-describedby="IrthGoldError-{{ section.id }}"
              {% endif %}
            >
          </div>

          <div class="irth-gold__field">
            <label for="IrthGoldPhone-{{ section.id }}" class="visually-hidden">
              {{ section.settings.phone_placeholder | escape }}
            </label>
            <input
              id="IrthGoldPhone-{{ section.id }}"
              class="irth-gold__input"
              type="tel"
              name="contact[phone]"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="tel"
              placeholder="{{ section.settings.phone_placeholder | escape }}"
            >
          </div>

          <button type="submit" class="irth-gold__submit">
            {{ section.settings.button_label | escape }}
          </button>
        </div>

        {%- if form.errors and form.id == blank -%}
          <div id="IrthGoldError-{{ section.id }}" class="irth-gold__message irth-gold__message--error" tabindex="-1">
            {{- form.errors.translated_fields.email | capitalize }}
            {{ form.errors.messages.email -}}
          </div>
        {%- endif -%}

        {%- if form.posted_successfully? and form.id == blank -%}
          <div class="irth-gold__message irth-gold__message--success" tabindex="-1">
            {{ section.settings.success_message | escape }}
          </div>
        {%- endif -%}

        <p class="irth-gold__consent">{{ section.settings.consent_text | escape }}</p>
      {%- endform -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .irth-gold {
    background: var(--irth-gold-bg, #111111);
    color: var(--irth-gold-text, #f3efe7);
    padding-block: clamp(48px, 6vw, 88px);
  }

  .irth-gold__inner {
    display: flex;
    justify-content: center;
    padding-inline: var(--page-margin, 16px);
  }

  .irth-gold__panel {
    width: 100%;
    max-width: 620px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .irth-gold__eyebrow {
    margin: 0;
    color: #b0885e;
    font-family: var(--font-accent--family, var(--font-body--family));
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  [dir='rtl'] .irth-gold__eyebrow {
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .irth-gold__heading {
    margin: 0;
    font-family: 'IRTH Sakkal Seta', 'IRTH DecoType Thuluth', 'IRTH Thmanyah Serif', 'Noto Naskh Arabic', var(--font-heading--family);
    font-size: clamp(1.5rem, 2.6vw, 2.125rem);
    line-height: 1.25;
  }

  .irth-gold__body {
    margin: 0;
    max-width: 46ch;
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    line-height: 1.65;
    color: rgb(243 239 231 / 82%);
  }

  .irth-gold__body p {
    margin: 0 0 0.6em;
  }

  .irth-gold__body p:last-child {
    margin-bottom: 0;
  }

  .irth-gold__form {
    width: 100%;
    margin-block-start: 10px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .irth-gold__fields {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
  }

  .irth-gold__field {
    flex: 1 1 220px;
    min-width: 0;
  }

  /* The class is repeated to out-specify base.css's `input:not(...)` rule
     (0,1,1), which otherwise wins over a single class (0,1,0) and overrides
     background-color regardless of source order — the input rendered ivory
     text on an ivory background as a result. Same fix as the footer heading
     and product-card title elsewhere in this theme's custom CSS. */
  .irth-gold__input.irth-gold__input {
    width: 100%;
    height: 48px;
    padding-inline: 18px;
    border-radius: 999px;
    border: 1px solid rgb(243 239 231 / 28%);
    background: rgb(243 239 231 / 6%);
    color: #f3efe7;
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
  }

  .irth-gold__input::placeholder {
    color: rgb(243 239 231 / 55%);
  }

  .irth-gold__input:focus-visible {
    outline: 2px solid #b0885e;
    outline-offset: 2px;
  }

  .irth-gold__submit {
    flex: 1 1 160px;
    height: 48px;
    border-radius: 999px;
    border: 1px solid #b0885e;
    background: #b0885e;
    color: #111111;
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .irth-gold__submit:hover {
    background: transparent;
    color: #b0885e;
  }

  .irth-gold__message {
    font-family: var(--font-body--family);
    font-size: 0.875rem;
  }

  .irth-gold__message--error {
    color: #e3a0a0;
  }

  .irth-gold__message--success {
    color: #b0885e;
  }

  .irth-gold__consent {
    margin: 6px 0 0;
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    line-height: 1.5;
    color: rgb(243 239 231 / 50%);
  }

  @media screen and (max-width: 749px) {
    .irth-gold__fields {
      flex-direction: column;
    }

    .irth-gold__field,
    .irth-gold__submit {
      flex-basis: auto;
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "IRTH Gold Membership",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "الإطلاق الرسمي ١ أكتوبر ٢٠٢٦ — Official Launch October 1st"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "عضوية إرث الذهبية — IRTH Gold Membership"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>الموقع حاليًا في مرحلة تجريبية، ونستعد لإطلاقه رسميًا في ١ أكتوبر ٢٠٢٦ بإذن الله. من يسجل الآن ينضم إلى دائرة عملاء إرث الأوائل — عضوية ذهبية بامتيازات دائمة: خصومات حصرية، أولوية في العروض الخاصة، ووصول مبكر لكل إصدار جديد.</p><p>The store is currently in preview as we prepare for our official launch on October 1st, 2026. Register now to join IRTH's founding circle — a Gold Membership with lifetime privileges: exclusive discounts, priority access to special offers, and early access to every new release.</p>"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "البريد الإلكتروني — Email"
    },
    {
      "type": "text",
      "id": "phone_placeholder",
      "label": "Phone placeholder",
      "default": "رقم الهاتف (اختياري) — Phone (optional)"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "انضم الآن — Join Now"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "تم! أنت الآن ضمن عملاء إرث الأوائل. — You're in. Welcome to IRTH's founding circle."
    },
    {
      "type": "text",
      "id": "consent_text",
      "label": "Consent text",
      "default": "بالتسجيل، أنت توافق على تلقي تحديثات وعروض حصرية من إرث. — By signing up, you agree to receive updates and exclusive offers from IRTH."
    },
    {
      "type": "text",
      "id": "signup_tags",
      "label": "Customer tags applied on signup",
      "default": "gold-founding-member, pre-launch"
    }
  ],
  "presets": [
    {
      "name": "IRTH Gold Membership"
    }
  ]
}
{% endschema %}
