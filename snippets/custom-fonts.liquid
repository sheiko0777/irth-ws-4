{% style %}
/* IRTH custom fonts. Ciguatera + Thmanyah Serif are now the site-wide heading fonts
   (set on --font-heading--family in snippets/theme-styles-variables.liquid) — Latin text
   renders via Ciguatera, Arabic text falls through to Thmanyah Serif automatically since
   Ciguatera has no Arabic glyphs. Utility classes below remain for manual overrides.

   Rendered as a snippet (not a static asset) so the asset_url filter below actually
   resolves — Shopify serves assets/*.css.liquid as a raw static file and never runs
   Liquid inside it, which silently broke these @font-face src URLs.

   Each face loads a WOFF2 first (Arabic faces subset to their unicode-range, ~75%
   smaller) and keeps the original TTF/OTF as a fallback. */

@font-face {
  font-family: 'IRTH Ciguatera';
  src: url('{{ "irth-ciguatera.woff2" | asset_url }}') format('woff2'),
    url('https://cdn.shopify.com/s/files/1/0773/8238/5802/files/IRTH-Ciguatera.otf?v=1782953230') format('opentype');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: 'IRTH A Suls';
  src: url('{{ "irth-a-suls.woff2" | asset_url }}') format('woff2'),
    url('{{ "irth-a-suls.ttf" | asset_url }}') format('truetype');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
  unicode-range: U+0600-06FF, U+0750-077F, U+FB50-FDFF, U+FE70-FEFF;
}

@font-face {
  font-family: 'IRTH Thmanyah Serif';
  src: url('{{ "irth-thmanyah-serif-bold.woff2" | asset_url }}') format('woff2'),
    url('https://cdn.shopify.com/s/files/1/0773/8238/5802/files/IRTH-ThmanyahSerifBold.otf?v=1782953230') format('opentype');
  font-weight: 700;
  font-style: normal;
  font-display: swap;
  unicode-range: U+0600-06FF, U+0750-077F, U+FB50-FDFF, U+FE70-FEFF;
}

/* Genuine Thuluth calligraphy (DecoType) — verified real glyph outlines, unlike the
   earlier A Suls file. Served as a theme asset, not Shopify Files. */
@font-face {
  font-family: 'IRTH DecoType Thuluth';
  src: url('{{ "irth-decotype-thuluth.woff2" | asset_url }}') format('woff2'),
    url('{{ "irth-decotype-thuluth.ttf" | asset_url }}') format('truetype');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
  unicode-range: U+0600-06FF, U+0750-077F, U+FB50-FDFF, U+FE70-FEFF;
}

/* Sakkal Seta Pro — second Thuluth-style candidate, verified real glyph outlines. */
@font-face {
  font-family: 'IRTH Sakkal Seta';
  src: url('{{ "irth-sakkal-seta.woff2" | asset_url }}') format('woff2'),
    url('{{ "irth-sakkal-seta.ttf" | asset_url }}') format('truetype');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
  unicode-range: U+0600-06FF, U+0750-077F, U+FB50-FDFF, U+FE70-FEFF;
}

/* English editorial accent — auto-applies wherever Horizon's accent typography preset is used
   (captions, eyebrows, marquee) via the theme's own --font-accent--family token. Arabic locale
   overrides this below with A Suls instead, so it never fights the Arabic type system. */
:root {
  --font-accent--family: 'IRTH Ciguatera', var(--font-heading--family);
}

/* Manual utility classes, available for direct use in custom sections if needed */
.irth-font-ciguatera {
  font-family: 'IRTH Ciguatera', var(--font-accent--family);
}

.irth-font-a-suls {
  font-family: 'IRTH A Suls', var(--font-accent--family);
}

/* Arabic editorial headings — replaces Noto Naskh Arabic for AR headings only */
[dir="rtl"] .irth-font-thmanyah,
[dir="rtl"] h1.irth-font-thmanyah,
[dir="rtl"] h2.irth-font-thmanyah {
  font-family: 'IRTH Thmanyah Serif', 'Noto Naskh Arabic', var(--font-heading--family);
  font-weight: 700;
}

/* Arabic locale: use Thmanyah Serif for h1/h2 site-wide by default, A Suls for eyebrows/captions */
html[lang="ar"] h1,
html[lang="ar"] h2 {
  font-family: 'IRTH Thmanyah Serif', 'Noto Naskh Arabic', var(--font-heading--family);
}

html[lang="ar"] {
  --font-accent--family: 'IRTH A Suls', 'Noto Naskh Arabic', var(--font-heading--family);
}
{% endstyle %}
